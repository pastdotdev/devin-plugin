{
  "hooks": {
    "SessionStart": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/bin/past\" start", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/bin/past\" prompt", "timeout": 6 }] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/bin/past\" stop", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/bin/past\" end", "timeout": 5 }] }
    ]
  }
}
